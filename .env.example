# Copy to .env for local dev (netlify dev reads it). NEVER commit .env.
# On Netlify: Site configuration -> Environment variables (scope: Functions).

# Required. Create at https://openrouter.ai/keys and set a credit limit on the key.
OPENROUTER_API_KEY=

# Chat/coach model and vision model (screenshot import). Any OpenRouter model id with tool support.
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
OPENROUTER_VISION_MODEL=deepseek/deepseek-v4.1-flash

# Optional passcode. Visitors who enter it skip the free-message limit.
ACCESS_CODE=

# Rate limits (defaults shown)
FREE_MESSAGES_PER_DAY=5       # per IP, without access code
RATE_LIMIT_PER_10MIN=20       # per IP, with access code
RATE_LIMIT_PER_DAY=100        # per IP, with access code
AI_DAILY_CAP=300              # global requests/day across all visitors

# Comma-separated allowed origins for the API (blank = same-origin only)
ALLOWED_ORIGINS=https://pokerlab12.netlify.app
